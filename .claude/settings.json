{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "superpowers-symfony@superpowers-symfony-local": false
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:arasaac.org)",
      "mcp__claude-in-chrome",
      "ClaudeInChromeDomain(localhost:8081)",
      "ClaudeInChromeDomain(docs.expo.dev)",
      "ClaudeInChromeDomain(github.com)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(jq *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npm view *)",
      "Bash(npm outdated*)",
      "Bash(npm audit*)",
      "Bash(npm explain *)",
      "Bash(npx expo *)",
      "Bash(npx expo-doctor*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx jest*)",
      "Bash(npx lint-staged*)",
      "Bash(npx commitlint *)",
      "Bash(npx audit-ci*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git remote -v)",
      "Bash(git ls-remote *)",
      "Bash(git tag -l*)",
      "Bash(adb devices*)",
      "Bash(adb logcat*)",
      "Bash(adb install *)",
      "Bash(adb reverse *)",
      "Bash(adb exec-out screencap *)",
      "Bash(curl -s http://localhost:8081*)",
      "Bash(adb shell input *)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git tag *)",
      "Bash(npx eas-cli*)",
      "Bash(eas *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(npm publish*)",
      "Bash(adb shell rm *)",
      "Bash(adb uninstall *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"GPS project rule: if this message asks for a new feature, screen or user-facing behaviour change (even casually), run the feature skill first: clarification interview, spec in docs/specs/, user validation, then code. Never fill a missing requirement with a guess.\"}}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_response.filePath // .tool_input.file_path // empty\"); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*) \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown --log-level warn --ignore-path \"$CLAUDE_PROJECT_DIR/.prettierignore\" \"$f\" ;; esac 2>/dev/null || true",
            "statusMessage": "Prettier"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo \"# Contexte de reprise (docs/status.md)\" && cat docs/status.md && echo && echo \"# Derniers commits\" && git log --oneline -10 && echo && echo \"# Fichiers non commités\" && git status --short"
          }
        ]
      }
    ]
  }
}
