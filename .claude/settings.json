{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "superpowers-symfony@superpowers-symfony-local": false
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:arasaac.org)",
      "mcp__claude-in-chrome",
      "ClaudeInChromeDomain(localhost:8081)",
      "ClaudeInChromeDomain(docs.expo.dev)",
      "ClaudeInChromeDomain(github.com)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(jq *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npm view *)",
      "Bash(npm outdated*)",
      "Bash(npm audit*)",
      "Bash(npm explain *)",
      "Bash(npx expo *)",
      "Bash(npx expo-doctor*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx jest*)",
      "Bash(npx lint-staged*)",
      "Bash(npx commitlint *)",
      "Bash(npx audit-ci*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git remote -v)",
      "Bash(git ls-remote *)",
      "Bash(git tag -l*)",
      "Bash(adb devices*)",
      "Bash(adb logcat*)",
      "Bash(adb install *)",
      "Bash(adb reverse *)",
      "Bash(adb exec-out screencap *)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git tag *)",
      "Bash(npx eas-cli*)",
      "Bash(eas *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(npm publish*)",
      "Bash(adb shell rm *)",
      "Bash(adb uninstall *)"
    ]
  }
}
